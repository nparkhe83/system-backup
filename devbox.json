{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.7/.schema/devbox.schema.json",
  "packages": [
    "ansible@2.17.6",
    "ansible-lint@24.9.2"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "echo '\n\nDevbox and Ansible are not compatible in Linux. \nDevelopment only possible on MacOS'"
    ],
    "scripts": {
      "add_git-hooks": [
        "bash ./bin/init-repo.sh"
      ]
    }
  }
}